{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/sync-claude 2>&1 || true",
            "timeout": 120,
            "statusMessage": "Sincronizando skills, ae-mcp y blender-mcp..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.local/bin/sync-claude push >/dev/null 2>&1 || true",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
